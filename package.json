{
  "name": "dsh-manim",
  "version": "1.1.19",
  "description": "DSH 的 Manim 动画工作室：侧边栏「动画」行 + 右侧栏「动画工作室」tab，用论文/方法生成讲解视频。宿主半边管工作区门控、渲染引擎（自带的 Python venv 里跑 manim 0.22）、视频/分镜的 Range 流式回放，外加三个 agent 工具 manim_scene / manim_render / manim_frames。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "runtime",
    "src",
    "skills",
    "templates",
    "tools",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "cordis.patch.yml",
    "LICENSE",
    "assets/icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "setup:runtime": "node runtime/setup-runtime.mjs",
    "test": "node tools/build.mjs && node tools/test-activation.mjs && node tools/test-offline.mjs && node tools/check-panel-markup.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "manim",
    "animation",
    "explainer",
    "video",
    "cordis",
    "explainer-video",
    "text-to-speech"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Strivy-ZSY/dsh-manim.git"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1"
  },
  "icon": "assets/icon.svg"
}
